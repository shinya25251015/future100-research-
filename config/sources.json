      "endpoint": "https://api.usaspending.gov/api/v2/search/spending_by_award/",
      "lookback_days": 7,
      "body": {
        "filters": {
          "award_type_codes": ["A", "B", "C", "D"],
          "time_period": [{ "start_date": "{{start_date}}", "end_date": "{{end_date}}" }]
        },
        "fields": ["Award ID", "Recipient Name", "Award Amount", "Description", "Awarding Agency", "Last Modified Date"],
        "limit": 100,
        "sort": "Last Modified Date",
        "order": "desc"
      },
      "mapping": {
        "items_path": "results",
        "url_template": "https://www.usaspending.gov/award/{generated_internal_id}",
        "title": "Description",
        "body": ["Recipient Name", "Awarding Agency", "Award ID"],
        "published_at": "Last Modified Date"
      },
